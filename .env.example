# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# PayStack Configuration
# WARNING: Never expose your secret key in frontend code!
# This is for demo purposes only. In production, use a backend proxy.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
VITE_PAYSTACK_SECRET_KEY=sk_test_your_secret_key

# Backend Proxy Configuration (Recommended for Production)
VITE_USE_BACKEND_PROXY=false
VITE_BACKEND_URL=http://localhost:3001
VITE_PAYSTACK_MODE=test

# For Production with Backend Proxy:
# VITE_USE_BACKEND_PROXY=true
# VITE_BACKEND_URL=https://your-backend-domain.com
# VITE_PAYSTACK_MODE=live
# Remove VITE_PAYSTACK_SECRET_KEY completely

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Stripe Configuration (if using Stripe as alternative)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key